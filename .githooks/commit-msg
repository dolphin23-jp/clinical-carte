#!/bin/sh
# コミットメッセージに、実在の患者を思わせる文字列（電話番号・生年月日など）を書かない（AGENTS.md）。
# 有効にする：git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel) || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "phi-guard: node が見つからないため、コミットを中止しました。" >&2
  exit 1
fi

exec node "$root/scripts/phi-guard.mjs" --message "$1"
