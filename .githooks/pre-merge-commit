#!/bin/sh
# マージのコミットでも、取り込む内容を検査する（pre-commit は、マージでは動かない）。
# 有効にする：git config core.hooksPath .githooks
# 検査の中身：scripts/phi-guard.mjs（外部依存なし）

root=$(git rev-parse --show-toplevel) || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "phi-guard: node が見つからないため、マージを中止しました。" >&2
  exit 1
fi

exec node "$root/scripts/phi-guard.mjs" --staged
